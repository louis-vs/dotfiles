[init]
	defaultBranch = master

[core]
    eol=lf
    editor=nvim
    whitespace=-space-before-tab
    pager = delta

[interactive]
    diffFilter = delta --color-only

# delta pager
[delta]
    navigate = true
    dark = true

[diff]
	tool = nvimdiff

[color]
    ui=always

[commit]
    gpgSign=true

[merge]
    conflictStyle = zdiff3 # needed for delta

# work repos use the work identity. config.work is supplied by the work branch,
# so it is absent elsewhere and the include is silently ignored. Must stay last:
# later config wins, so this would be overridden if it sat above [user].
[includeIf "gitdir/i:~/work/"]
    path = config.work
