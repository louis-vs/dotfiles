[init]
	defaultBranch = master

[core]
    eol=lf
    editor=nvim
    whitespace=-space-before-tab
    pager = delta

[interactive]
    diffFilter = delta --color-only

# delta pager
[delta]
    navigate = true
    dark = true

[diff]
	tool = nvimdiff

[color]
    ui=always

[commit]
    gpgSign=true

[merge]
    conflictStyle = zdiff3 # needed for delta
